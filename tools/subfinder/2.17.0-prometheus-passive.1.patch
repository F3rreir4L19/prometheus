+package main
+
+import (
+	"bytes"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+)
+
+type responseTransport func(*http.Request) (*http.Response, error)
+
+func (f responseTransport) RoundTrip(request *http.Request) (*http.Response, error) {
+	return f(request)
+}
+
+func TestPassiveProfile(t *testing.T) {
+	for _, tc := range []struct {
+		status, exit int
+	}{
+		{200, 0}, {302, 1}, {429, 29}, {503, 53},
+	} {
+		args := []string{"-d", "example.test", "-silent", "-oJ", "-duc",
+			"-s", "hackertarget", "-rsr", "4194304", "-t", "1"}
+		var output bytes.Buffer
+		calls := 0
+		transport := responseTransport(func(request *http.Request) (*http.Response, error) {
+			calls++
+			if got := request.URL.String(); got != "https://api.hackertarget.com/hostsearch/?q=example.test" {
+				t.Errorf("unexpected request %s", got)
+			}
+			return &http.Response{
+				StatusCode: tc.status,
+				Header:     http.Header{"Location": {"https://outside.example.test/"}},
+				Body:       io.NopCloser(strings.NewReader("www.example.test,192.0.2.1\n")),
+			}, nil
+		})
+		if exit := run(args, &output, transport); exit != tc.exit || calls != 1 {
+			t.Fatalf("status %d: exit %d, requests %d", tc.status, exit, calls)
+		}
+		if tc.exit == 0 && !strings.Contains(output.String(), `"host":"www.example.test"`) {
+			t.Fatalf("expected JSONL hostname: %q", output.String())
+		}
+		if tc.exit != 0 && output.Len() != 0 {
+			t.Fatal("non-successful response supplied candidate output")
+		}
+
+		args[1] = "example.test&apikey=value"
+		if exit := run(args, io.Discard, transport); exit != 1 || calls != 1 {
+			t.Fatal("malformed seed reached the provider")
+		}
+	}
+}
